# Generated by ToolConfig from .toolconfig.toml. Edit that file instead.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,py,pyi}]
indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.snap]
trim_trailing_whitespace = false
insert_final_newline = unset
