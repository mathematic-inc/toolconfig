---
source: tests/cli.rs
expression: "project.ok(&[\"explain\", \"vale\"])"
---
vale -> .vale.ini (from .toolconfig.toml)
  StylesPath                   ".vale/styles"      vale default
  MinAlertLevel                "warning"           .toolconfig.toml:14 ["*"] vale.MinAlertLevel
  Vocab                        "Terms"             .toolconfig.toml:15 ["*"] vale.Vocab
  formats.rs                   "md"                .toolconfig.toml:18 ["*"] vale.formats.rs
  "*.{md,rs}".BasedOnStyles    ["Vale","STE"]      .toolconfig.toml:21 ["*"] vale."*.{md,rs}".BasedOnStyles
  "*.{md,rs}"."Vale.Spelling"  "NO"                .toolconfig.toml:22 ["*"] vale."*.{md,rs}"."Vale.Spelling"
  "*.{md,rs}".TokenIgnores     ["(x{2,3})","(y)"]  .toolconfig.toml:23 ["*"] vale."*.{md,rs}".TokenIgnores
