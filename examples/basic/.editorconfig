# Generated by ToolConfig from .toolconfig.toml. Edit that file instead.
root = true

[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{rs,py,pyi}]
indent_size = 4

[*.md]
max_line_length = 80

[*.sh]
shell_variant = bash
switch_case_indent = true
