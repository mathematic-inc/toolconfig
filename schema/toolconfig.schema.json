  "definitions": {
    "section": {
      "description": "An EditorConfig section. The key is a glob; later sections take precedence.",
      "type": "object",
      "properties": {
        "indent_style": {
          "description": "Indent with spaces or tabs.",
          "enum": [
            "space",
            "tab",
            "unset"
          ]
        },
        "indent_size": {
          "description": "Columns per indentation level, or \"tab\" to use tab_width.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "enum": [
                "tab",
                "unset"
              ]
            }
          ]
        },
        "tab_width": {
          "description": "Columns a tab character occupies. Defaults to indent_size.",
          "anyOf": [
            {
